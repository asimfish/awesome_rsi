import re
from pathlib import Path

P = Path('/Users/liyufeng/Desktop/research/awesome_rsi/report/awesome_rsi_slides.html')
CJK = lambda s: len(re.findall(r'[\\u4e00-\\u9fff]', s))
TOKENS = lambda s: re.findall(r'[A-Za-z0-9]+(?:[-._/][A-Za-z0-9]+)*', s)

def edit_slide(n, pairs):
    text = P.read_text(encoding='utf-8')
    match = re.search(r'<section class=\"slide\" data-n=\"' + str(n) + r'\">.*?</section>', text, re.S)
    assert match, n
    old = re.split(r'(<["'^>]+>)'"', match.group())
    new = old.copy()
    for before, after in pairs:
        found = 0
        for i in range(0, len(new), 2):
            found += new[i].count(before)
            new[i] = new[i].replace(before, after)
        assert found == 1, (n, before, found)
    changed = 0
    for i, (a, b) in enumerate(zip(old, new)):
        if a == b:
            continue
        assert i % 2 == 0, (n, 'tag changed')
        assert CJK(b) <= CJK(a), (n, 'node grew', CJK(a), CJK(b), a, b)
        assert TOKENS(a) == TOKENS(b), (n, 'English/number changed', a, b)
        changed += 1
    result = text[:match.start()] + ''.join(new) + text[match.end():]
    P.write_text(result, encoding='utf-8')
    print(f'slide {n}: {changed} text nodes, CJK {CJK(match.group())} -> {CJK(\"\".join(new))}')

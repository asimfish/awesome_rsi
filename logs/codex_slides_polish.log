<script>
(function(){
  var slides = document.querySelectorAll('.slide');
  var total = slides.length;
  var cur = Math.min(Math.max(parseInt(location.hash.slice(1)) || 1, 1), total);
  var hud = document.getElementById('cur');
  var bar = document.getElementById('bar');
  function fit(){
    var s = Math.min(window.innerWidth / 1320, window.innerHeight / 760);
    document.documentElement.style.setProperty('--s', s);
    slides.forEach(function(el){ el.style.setProperty('--s', s); });
  }
  function show(n){
    cur = Math.min(Math.max(n, 1), total);
    slides.forEach(function(el, i){ el.classList.toggle('active', i === cur - 1); });
    hud.textContent = cur;
    bar.style.width = (cur / total * 100) + '%';
    history.replaceState(null, '', '#' + cur);
  }
  window.addEventListener('keydown', function(e){
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') show(cur + 1);
    else if (e.key === 'ArrowLeft' || e.key === 'PageUp') show(cur - 1);
    else if (e.key === 'Home') show(1);
    else if (e.key === 'End') show(total);
    else if (e.key === 'p' || e.key === 'P') window.print();
  });
  document.getElementById('deck').addEventListener('click', function(e){
    if (e.clientX > window.innerWidth / 2) show(cur + 1); else show(cur - 1);
  });
  window.addEventListener('resize', fit);
  fit(); show(cur);
})();
</script>
</body>
</html>


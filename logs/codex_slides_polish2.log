python3 - <<'PY'
import re,subprocess,html
from html.parser import HTMLParser
p='report/awesome_rsi_slides.html'
a=subprocess.run(['git','show',f'HEAD:{p}'],capture_output=True,text=True,check=True).stdout
b=open(p,encoding='utf-8').read()
x=re.split(r'<["'^>]+>'"',a); y=re.split(r'<["'^>]+>'"',b)
cjk=lambda s:len(re.findall(r'[\\u4e00-\\u9fff]',s))
protected=lambda s:re.findall(r'[A-Za-z0-9_]+(?:[./:+%"'^-][A-Za-z0-9_]+)*|['"\\u0370-\\u03ff]+',s)
changed=[]
for u,v in zip(x,y):
    if u==v: continue
    assert cjk(v)<=cjk(u) and len(v)<=len(u) and len(html.unescape(v))<=len(html.unescape(u)),('node grew',u,v)
    assert protected(u)==protected(v),('protected text changed',u,v)
    changed.append((u,v))
class Audit(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=False)
        self.stack=[]; self.nodes=[]; self.page=0; self.bold=0
    def handle_starttag(self,tag,attrs):
        d=dict(attrs)
        if tag=='section' and d.get('class')=='slide': self.page=int(d['data-n'])
        if tag=='b': self.bold+=1
        if tag not in {'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr'}:
            self.stack.append((tag,d))
    def handle_endtag(self,tag):
        if tag=='b': self.bold-=1; assert self.bold>=0
        idx=next((i for i in range(len(self.stack)-1,-1,-1) if self.stack[i][0]==tag),None)
        if idx is not None: self.stack=self.stack[:idx]
        if tag=='section': self.page=0
    def handle_data(self,data):
        self.nodes.append((self.page,tuple((tag,tuple(sorted(attrs.items()))) for tag,attrs in self.stack),data))
s=Audit(); s.feed(a); q=Audit(); q.feed(b)
assert s.bold==q.bold==0
assert len(s.nodes)==len(q.nodes)
for (pn,path,u),(qn,qpath,v) in zip(s.nodes,q.nodes):
    assert pn==qn and path==qpath
    if u==v: continue
    assert 22<=pn<=34
    assert path[-1][0] in {'h2','h3','p','li','td','span','b'}
    assert all('footer' not in dict(attrs).get('class','').split() for _,attrs in path)
print('extended checks ok:',len(changed),'changed text nodes; allowed tags, scope, lengths, English, numbers, Greek, footers, paired b')

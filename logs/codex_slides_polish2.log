        assert x==y, 'tag changed'
        m=re.match(r'<(/?)([a-zA-Z][\\w:-]*)\\b',x)
        if not m: continue
        closing,name=m.groups(); name=name.lower()
        if name=='b':
            bold += -1 if closing else 1
            if bold<0: errors.append(('unpaired b',i))
        if closing:
            found=next((j for j in range(len(stack)-1,-1,-1) if stack[j][0]==name),None)
            if found is not None: stack=stack[:found]
            if name=='section': page=0
        else:
            if name=='section' and 'class=\"slide\"' in x:
                page=int(re.search(r'data-n=\"(\\d+)\"',x).group(1))
            if name not in void and not x.endswith('/>'): stack.append((name,x))

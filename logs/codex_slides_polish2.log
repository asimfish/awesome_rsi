import re, subprocess, html
from collections import Counter
p='report/awesome_rsi_slides.html'
a=subprocess.run(['git','show',f'HEAD:{p}'],capture_output=True,text=True,check=True).stdout
b=open(p,encoding='utf-8').read()
ap=re.split(r'(<["'^>]+>)'"',a); bp=re.split(r'(<["'^>]+>)'"',b)
assert len(ap)==len(bp)
cjk=lambda s:len(re.findall(r'[\\u4e00-\\u9fff]',s))
english=lambda s:re.findall(r'[A-Za-z0-9_]+(?:[./:+%"'^-][A-Za-z0-9_]+)*'"',s)
nums=lambda s:re.findall(r'\\d+(?:\\.\\d+)?%?',s)
allowed={'h2','h3','p','li','td','span','b'}
void={'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr'}
stack=[]; page=0; modified=Counter(); errors=[]; bold=0
for i,(x,y) in enumerate(zip(ap,bp)):
    if i%2:
        assert x==y, 'tag changed'
        m=re.match(r'<(/?)([a-zA-Z][\\w:-]*)\\b',x)
        if not m: continue
        closing,name=m.groups(); name=name.lower()
        if name=='b':
            bold += -1 if closing else 1
            if bold<0: errors.append(('unpaired b',i))
        if closing:
            found=next((j for j in range(len(stack)-1,-1,-1) if stack[j][0]==name),None)
            if found is not None: stack=stack[:found]
            if name=='section': page=0
        else:
            if name=='section' and 'class=\"slide\"' in x:
                page=int(re.search(r'data-n=\"(\\d+)\"',x).group(1))
            if name not in void and not x.endswith('/>'): stack.append((name,x))
        continue
    if x==y: continue
    modified[page]+=1
    if page not in range(22,35): errors.append(('outside scope',page,x,y))
    if not stack or stack[-1][0] not in allowed: errors.append(('non-allowed parent',page,x,y))
    if any(re.search(r'class=\"["'^"]*'"\\bfooter\\b',t) for _,t in stack): errors.append(('footer',page,x,y))
    if cjk(y)>cjk(x) or len(y)>len(x) or len(html.unescape(y))>len(html.unescape(x)):
        errors.append(('node grew',page,cjk(x),cjk(y),len(x),len(y),x,y))
    if english(x)"'!=english(y): errors.append(('"'English changed',page,english(x),english(y)))
    if nums(x)"'!=nums(y): errors.append(('"'numbers moved or changed',page,nums(x),nums(y)))
    if re.findall(r'[\\u0370-\\u03ff]+',x)"'!=re.findall(r'"'[\\u0370-\\u03ff]+',y): errors.append(('Greek changed',page,x,y))
assert bold==0, 'unpaired b'
for e in errors: print(e)
old_total=new_total=0
for n in range(22,35):
    source=re.search(fr'<section class=\"slide\" data-n=\"{n}\">.*?</section>',a,re.S).group()
    edited=re.search(fr'<section class=\"slide\" data-n=\"{n}\">.*?</section>',b,re.S).group()
    old_total+=cjk(source); new_total+=cjk(edited)
    print(f'{n}: {cjk(source)} -> {cjk(edited)}; changed nodes: {modified[n]}')
print('slides 22-34:',old_total,'->',new_total)
print('changed nodes:',sum(modified.values()),'; errors:',len(errors))
assert not errors

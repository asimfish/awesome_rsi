def nums(s): return re.findall(r'\d+(?:\.\d+)?%?',s)
on,tn=nums(old),nums(t)
missing=[n for n in set(on) if on.count(n)>tn.count(n)]
assert not missing, ('numbers dropped',missing[:20])
def tables(s): return [l for l in s.splitlines() if l.startswith('|')]
assert len(tables(t))==len(tables(old)), ('table line count changed',len(tables(t)),len(tables(old)))
links=re.findall(r'\]\(((?:papers|reports|assets)[^)#]+)\)',t)
bad=[l for l in set(links) if not os.path.exists(l)]
assert not bad, bad
cjk=lambda s: len(re.findall(r'[\u4e00-\u9fff]',s))
ratio=cjk(t)/max(1,cjk(old))
assert 0.85<=ratio<=1.15, ('length changed too much',round(ratio,2))
print(p,'ok',cjk(old),'->',cjk(t))

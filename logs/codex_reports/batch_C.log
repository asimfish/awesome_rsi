import re,sys,subprocess,collections
p=sys.argv[1]
old=subprocess.run(['git','show',f'HEAD:{p}'],check=True,capture_output=True,text=True).stdout
t=open(p,encoding='utf-8').read()
patterns={
'headings':r'"'^#{2,3} .*$'"',
'metadata':r'"'^>.*$'"',
'links':r'\\]\\(["'^)]+'"\\)',
'code_blocks':r'(?s:"'```.*?```)'"',
'inline_code':r'"'`[''^`'"\\n]+"'`'"',
'crossrefs':r'\\*\\*对报告 .*?\\*\\*：',
'formulas':r'(?s:\\"'$'"\\"'$.*?'"\\"'$'"\\"'$)|'"\\"'$[''^'"\\n"'$]+'"\\"'$'"',
}
for label,pat in patterns.items():
    assert re.findall(pat,old,re.M)==re.findall(pat,t,re.M),(label,'changed',p)
nums=lambda s:re.findall(r'\\d+(?:\\.\\d+)?%?',s)
assert collections.Counter(nums(old))==collections.Counter(nums(t)),('numeric counts changed',p)
tabs=lambda s:[l.split('|')[1:-1] for l in s.splitlines() if l.startswith('|')]
ot,nt=tabs(old),tabs(t)
assert len(ot)==len(nt)
for i,(a,b) in enumerate(zip(ot,nt)):
    assert len(a)==len(b),('table columns',i)
    assert [nums(c) for c in a]==[nums(c) for c in b],('table cell numbers',i)
    if i==0 or set(''.join(a).strip())<=set('-: '):
        assert a==b,('table header/separator changed',i)
eng=lambda s:collections.Counter(re.findall(r'[A-Za-z][A-Za-z0-9_.+/-]*(?:ⁿ)?',s))
missing=eng(old)-eng(t)
assert not missing,('English terms dropped',dict(missing))
print(p,'protected content ok')

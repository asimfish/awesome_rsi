import re,sys,subprocess,collections
for p in sys.argv[1:]:
    t=open(p,encoding='utf-8').read()
    old=subprocess.run(['git','show',f'HEAD:{p}'],capture_output=True,text=True,check=True).stdout
    def same(label, fn):
        a,b=fn(old),fn(t)
        assert a==b, (p,label, a-b if isinstance(a,collections.Counter) else a, b-a if isinstance(b,collections.Counter) else b)
    same('exact headings', lambda s: re.findall(r'"'^#{2,3} .*$'"',s,re.M))
    same('opening metadata', lambda s: re.findall(r'"'^>.*$'"',s.split('\\n## ',1)[0],re.M))
    same('numbers', lambda s: collections.Counter(re.findall(r'\\d+(?:\\.\\d+)?%?',s)))
    same('links', lambda s: collections.Counter(re.findall(r'\\]\\((["'^)]+)'"\\)',s)))
    same('inline code', lambda s: collections.Counter(re.findall(r'(?<"'!'"\\x60)\\x60["'^'"\\x60\\n]+\\x60(?"'!'"\\x60)',s)))
    same('code blocks', lambda s: re.findall(r'"'^'"\\x60{3}.*?"'^'"\\x60{3}["'^'"\\n]*',s,re.M|re.S))
    same('math', lambda s: collections.Counter(re.findall(r'\\"'$'"\\"'$['"\\s\\S]*?\\"'$'"\\"'$|'"\\"'$(?!'"\\"'$)[''^'"\\n"'$]+'"\\"'$|'"\\\\\\[[\\s\\S]*?\\\\\\]|\\\\\\([\\s\\S]*?\\\\\\)',s)))
    same('English tokens', lambda s: collections.Counter(w for w in re.findall(r'[A-Za-z][A-Za-z0-9]*(?:[-_.][A-Za-z0-9]+)*\\+*',s) if not (p=='reports/02_anthropic_when_ai_builds_itself.md' and w=='again')))
    same('cross references', lambda s: re.findall(r'\\*\\*对报告 ["'^*'"\\n]+\\*\\*：',s))
    ot=[l for l in old.splitlines() if l.startswith('|')]
    nt=[l for l in t.splitlines() if l.startswith('|')]
    assert len(ot)==len(nt)
    for a,b in zip(ot,nt):
        ac,bc=a.split('|'),b.split('|')
        assert len(ac)==len(bc),(p,'table columns')
        assert [re.findall(r'\\d+(?:\\.\\d+)?%?',c) for c in ac]==[re.findall(r'\\d+(?:\\.\\d+)?%?',c) for c in bc],(p,'table cell numbers',a,b)
    def headers(s):
        lines=s.splitlines()
        return [l for i,l in enumerate(lines) if l.startswith('|') and (i==0 or not lines[i-1].startswith('|'))]
    same('table headers',headers)
    print(p,'protected content ok')

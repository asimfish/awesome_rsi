import hashlib,pathlib,subprocess,tempfile,zlib
root=pathlib.Path.cwd()
git='/Library/Developer/CommandLineTools/usr/bin/git'
entries=subprocess.check_output([git,'ls-files','-s','-z']).split(b'\\0')
base=pathlib.Path(tempfile.mkdtemp(prefix='rsi-report-review-',dir='/private/tmp'))
objects=base/'objects'; objects.mkdir()
def put(kind,data):
    raw=kind+b' '+str(len(data)).encode()+b'\\0'+data
    oid=hashlib.sha1(raw).hexdigest()
    p=objects/oid[:2]/oid[2:];p.parent.mkdir(exist_ok=True);p.write_bytes(zlib.compress(raw))
    return oid
nodes={}; index={}
for entry in entries:
    if not entry: continue
    meta,path=entry.split(b'\\t',1)
    mode,oid,stage=meta.split()
    assert stage==b'0'
    index[path.decode()]=(mode,oid.decode())
    n=nodes; parts=path.split(b'/')
    for part in parts[:-1]:n=n.setdefault(part,{})
    n[parts[-1]]=(mode,oid)
def tree(n):
    payload=b''
    for name,value in sorted(n.items(),key=lambda kv:kv[0]+(b'/' if isinstance(kv[1],dict) else b'')):
        if isinstance(value,dict):mode,oid=b'40000',tree(value).encode()
        else:mode,oid=value
        payload+=mode+b' '+name+b'\\0'+bytes.fromhex(oid.decode())
    return put(b'tree',payload)
root_oid=tree(nodes)
assert root_oid=='5e35875b3cf4035d9d40e0033d9f5467189ddaaa',root_oid

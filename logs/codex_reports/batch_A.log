assert hashlib.sha1(raw).hexdigest()==head
kind,data=raw.split(b'\\0',1);assert put(b'commit',data)==head
for p,(_,expected) in index.items():
    if p.startswith('reports/0') and p.split('/')[1][:2] in {'00','01','02','03','04','05','06'}:

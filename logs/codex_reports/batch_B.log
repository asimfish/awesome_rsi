import re, sys, subprocess, collections
for p in sys.argv[1:]:
    old = subprocess.run(['git', 'show', f'HEAD:{p}'], capture_output=True, text=True, check=True).stdout
    new = open(p, encoding='utf-8').read()
    def matches(pattern, text, flags=0): return re.findall(pattern, text, flags)
    for label, pattern, flags in [
        ('headings', r'"'^#{2,3} .*$'"', re.M),
        ('opening metadata', r'"'^>.*$'"', re.M),
        ('links', r'"'!?'"\\[["'^'"\\]\\n]*\\]\\(["'^'"\\n]*?\\)', 0),
        ('code blocks', r'"'^```[''^'"\\n]*\\n.*?"'^```[''^'"\\n]*"'$'"', re.M|re.S),
        ('inline code', r'(?<"'!`)`[''^`'"\\n]+"'`(?!`)'"', 0),
        ('math', r'\\"'$'"\\"'$.*?'"\\"'$'"\\"'$|(?<!'"\\"'$)'"\\"'$(?!'"\\"'$)[''^$'"\\n]+\\"'$(?!'"\\"'$)|'"\\\\\\[.*?\\\\\\]|\\\\\\(.*?\\\\\\)', re.S),
        ('cross reference labels', r'\\*\\*对报告 ["'^*]+'"\\*\\*：', 0),
    ]:
        assert matches(pattern, old, flags) == matches(pattern, new, flags), (p, label)
    def nums(s): return re.findall(r'\\d+(?:\\.\\d+)?%?', s)
    assert collections.Counter(nums(old)) == collections.Counter(nums(new)), (p, 'exact numeric counts')
    eng = r'[A-Za-z]+(?:[A-Za-z0-9_./@+\\-]*[A-Za-z0-9])?'
    eo, en = collections.Counter(re.findall(eng, old)), collections.Counter(re.findall(eng, new))
    assert eo == en, (p, 'English tokens', eo-en, en-eo)
    ot = [l for l in old.splitlines() if l.startswith('|')]
    nt = [l for l in new.splitlines() if l.startswith('|')]
    assert len(ot)==len(nt), (p, 'table rows')
    for i,(a,b) in enumerate(zip(ot,nt)):
        ac,bc=a.split('|'),b.split('|')
        assert len(ac)==len(bc), (p, 'table columns', i)
        for j,(x,y) in enumerate(zip(ac,bc)):
            assert nums(x)==nums(y), (p, 'cell numbers', i,j)
        if i+1<len(ot) and re.fullmatch(r'[|:\\- ]+',ot[i+1]):
            assert a==b, (p,'table header',i)
    print(p, 'protected content ok')

numeric_format = r'(?<"'![A-Za-z0-9])(?:[+−-])?'"\\d+(?:\\.\\d+)?(?:[%×x]|[KMB])?(?:[–−-](?:[+−-])?\\d+(?:\\.\\d+)?(?:[%×x]|[KMB])?)?'
for p in sys.argv[1:]:
    old = subprocess.run(['git','show',f'HEAD:{p}'],capture_output=True,text=True,check=True).stdout
    new = open(p,encoding='utf-8').read()
    assert old.splitlines()[0].split('：')[0] == new.splitlines()[0].split('：')[0], (p,'primary title')
    def crossrefs(s):
        labels = re.findall(r'"'^'"\\*\\*(?:对|与)["'^*'"\\n]+\\*\\*：',s,re.M)
        return [label for label in labels if re.search(r'\\d',label)]
    assert crossrefs(old)==crossrefs(new),(p,'all cross-reference labels')
    for formula in formulas.get(p, []):
        assert old.count(formula)>0, (p,'invalid formula check',formula)
        assert old.count(formula)==new.count(formula),(p,'formula',formula)
    on, nn = collections.Counter(re.findall(numeric_format,old)),collections.Counter(re.findall(numeric_format,new))
    assert on==nn,(p,'number format',on-nn,nn-on)
    assert collections.Counter(re.findall(r'[Α-Ωα-ω]',old))==collections.Counter(re.findall(r'[Α-Ωα-ω]',new)),(p,'Greek symbols')
    style = []
    for n,line in enumerate(new.splitlines(),1):
        if line.startswith(('>','#')): continue
        line = re.sub(r'"'^'"\\*\\*(?:对|与)["'^*'"\\n]+\\*\\*：','',line)
        if re.search(r'不是.*而是|——|全谱系最重要|最干净|教科书式|真正的|房间里的大象|阿喀琉斯之踵|红海|资产化|工业化|纪律',line):
            style.append(n)
    assert not style,(p,'style residues outside protected text',style)
    print(p,'formulas, number formats, cross-references and style ok')

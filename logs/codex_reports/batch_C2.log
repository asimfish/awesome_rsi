/bin/zsh -lc "python3 - 'reports/20_metan.md' << 'PY'
import collections,re,subprocess,sys
for p in sys.argv[1:]:
    old=subprocess.run(['git','show',f'HEAD:{p}'],capture_output=True,text=True,check=True).stdout
    new=open(p,encoding='utf-8').read()
    def eq(label,a,b):
        assert a==b,(p,label,a,b)
    def matches(pattern,s,flags=0): return re.findall(pattern,s,flags)
    eq('headings',matches(r'"'^#{2,3} .*$'"',old,re.M),matches(r'"'^#{2,3} .*$'"',new,re.M))
    eq('metadata',matches(r'"'^>.*$'"',old,re.M),matches(r'"'^>.*$'"',new,re.M))
    eq('numbers',matches(r'\\d+(?:\\.\\d+)?%?',old),matches(r'\\d+(?:\\.\\d+)?%?',new))
    eq('links',matches(r'\\]\\((["'^)]+)'"\\)',old),matches(r'\\]\\((["'^)]+)'"\\)',new))
    bt=chr(96)
    blocks=r'"'^('"'+bt+r'{3,}|~{3,})["'^'"\\n]*\\n.*?"'^'"\\1[ \\t]*"'$'"'
    eq('code blocks',[(m.group(0)) for m in re.finditer(blocks,old,re.M|re.S)],[(m.group(0)) for m in re.finditer(blocks,new,re.M|re.S)])
    inline=r'(?<"'!'"'+bt+')('+bt+r'+)(?"'!'"'+bt+r')(.+?)\\1(?"'!'"'+bt+')'
    eq('inline code',matches(inline,old),matches(inline,new))
    eq('cross-references',matches(r'"'^'"\\*\\*对报告.*?\\*\\*：',old,re.M),matches(r'"'^'"\\*\\*对报告.*?\\*\\*：',new,re.M))
    ot=[line.split('|')[1:-1] for line in old.splitlines() if line.startswith('|')]
    nt=[line.split('|')[1:-1] for line in new.splitlines() if line.startswith('|')]
    eq('table count',len(ot),len(nt))
    for i,(a,b) in enumerate(zip(ot,nt)):
        eq(f'table row {i} columns',len(a),len(b))
        for j,(ac,bc) in enumerate(zip(a,b)):
            eq(f'table cell {i},{j} numbers',matches(r'\\d+(?:\\.\\d+)?%?',ac),matches(r'\\d+(?:\\.\\d+)?%?',bc))
        if i+1<len(ot) and all(re.fullmatch(r'\\s*:?-+:?\\s*',c) for c in ot[i+1]):
            eq(f'table row {i} headers',a,b)
    terms=lambda s: collections.Counter(matches(r\"[A-Za-z]+(?:[A-Za-z0-9_'./+↔-]*[A-Za-z0-9_+])?\",s))
    missing=terms(old)-terms(new); added=terms(new)-terms(old)
    eq('English tokens removed',dict(missing),{})
    eq('English tokens added',dict(added),{})
    print(p,'strict ok')

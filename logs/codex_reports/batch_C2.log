formulas={
'reports/16_autosaddler.md':[
'θ = (prompt, tool, middleware)','D_train / D_dev / D_test','B_n ⊂ D_train',
\"H'_n = H_n + Δθ_n\",\"Ĵ_Bn(H'_n) > Ĵ_Bn(H_n)\",'H_{n+1}','G = (V, E)','−0.24pp/iter','+0.16pp/iter'],
'reports/17_metacaster.md':[
'K∈{10,30,50}','min_θ E_{m,l} [δ(ω(f_l"'^m), ω(f̄_l''^m))]'"',
'f_l"'^m'"','{D_tr, D_val}','f̄_l"'^m'"','{D̄_tr, D̄_val}','K ∈ {10, 30, 50}','10⁵'],
'reports/19_icoder.md':['Data→SFT→OPSD→RLVR'],
'reports/20_metan.md':['1..d−1','L(d)','d1→d2'],
'reports/21_co_harness.md':[
'(θ_t, φ_t)','F⁻_t','A_t = C(F⁻_t, φ_t)','ΔΦ_t = AggregateDiffs(A_t)',
'φ̃_t','δ_in > 0','δ_out ≥ 0','φ*_t','D_t','θ_{t+1} = argmax Σ log p_θ(τ|x)',
'{root cause, harness dim, severity, evidence, diff suggestion}',
'δ_in > 0 且 δ_out ≥ 0 vs Δ_in ≥ 0 且 Δ_ho ≥ 0 且 max > 0']
}
for p in sys.argv[1:]:
    old=subprocess.run(['git','show',f'HEAD:{p}'],capture_output=True,text=True,check=True).stdout
    new=open(p,encoding='utf-8').read()
    for literal in formulas.get(p,[]):
        assert old.count(literal)>0,(p,'bad baseline formula',literal)
        assert old.count(literal)==new.count(literal),(p,'formula changed',literal)
    phrase=r'(?<"'![A-Za-z])[A-Za-z][A-Za-z0-9_-]*(?:[ '"\\t]+[A-Za-z][A-Za-z0-9_-]*)+'
    phrases=lambda s: collections.Counter(re.findall(phrase,s))
    missing={phrase:old.count(phrase)-new.count(phrase) for phrase in phrases(old) if old.count(phrase)>new.count(phrase)}
    assert not missing,(p,'English phrase removed',missing)
    refs=lambda s: re.findall(r'"'^'"\\*\\*(?:对报告|与报告|对 iCoder).*?\\*\\*',s.split('## 7. 意义与位置',1)[1],re.M)
    assert refs(old)==refs(new),(p,'section 7 lead-in changed')
    lists=lambda s: collections.Counter(re.findall(r'"'^(?:[-*]|'"\\d+\\.|[❶❷❸❹❺❻❼❽❾❿])\\s+',s,re.M))
    assert lists(old)==lists(new),(p,'list count changed')
    signed=lambda s: re.findall(r'[+−-]?\\d+(?:\\.\\d+)?[⁰¹²³⁴⁵⁶⁷⁸⁹]*%?',s)
    assert signed(old)==signed(new),(p,'signed number changed')
    ranges=lambda s: re.findall(r'\\d+(?:\\.\\d+)?%?(?:[–−→/-]\\d+(?:\\.\\d+)?%?)+',s)
    assert ranges(old)==ranges(new),(p,'numeric range changed')
    print(p,'formulas, phrases, references, lists, number notation ok')
